# Copy this file to .env and fill it in for LOCAL runs.
# In GitHub Actions these come from repository Secrets instead.
# .env is gitignored — never commit a filled-in copy.

# From the Browserbase dashboard -> Settings. This one key is all you need;
# Browserbase works out the project from it.
BROWSERBASE_API_KEY=bb_live_xxxxxxxxxxxxxxxxxxxxxxxx

# Created for you by `npm run import-cookies` the first time you run it.
# Save the value it prints, both here and as a GitHub Secret.
BROWSERBASE_CONTEXT_ID=

# Where the remote browser runs. Pick the one nearest you, then leave it alone:
# every change looks like a new country to TikTok and can trigger a challenge.
# us-west-2 | us-east-1 | eu-central-1 | ap-southeast-1
BROWSERBASE_REGION=eu-central-1

# Optional. Only if one API key spans several Browserbase projects.
BROWSERBASE_PROJECT_ID=

# Optional. Walk the whole flow without actually sending anything.
DRY_RUN=false
